{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "asset-tracker-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "5173", "."],
      "port": 5173
    },
    {
      "name": "asset-tracker-powershell",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$l=[System.Net.HttpListener]::new();$l.Prefixes.Add('http://localhost:5174/');$l.Start();Write-Host 'serving on http://localhost:5174';while($l.IsListening){$c=$l.GetContext();$p=$c.Request.Url.LocalPath.TrimStart('/');if(!$p){$p='index.html'};$f=Join-Path (Get-Location) $p;if(Test-Path $f -PathType Leaf){$b=[System.IO.File]::ReadAllBytes($f);$ct=switch([System.IO.Path]::GetExtension($f)){'.html'{'text/html; charset=utf-8'}'.js'{'text/javascript'}'.css'{'text/css'}'.json'{'application/json'}'.gs'{'text/plain'}'.md'{'text/plain; charset=utf-8'}default{'application/octet-stream'}};$c.Response.ContentType=$ct;$c.Response.Headers.Add('Cache-Control','no-store');$c.Response.OutputStream.Write($b,0,$b.Length)}else{$c.Response.StatusCode=404};$c.Response.Close()}"
      ],
      "port": 5174
    }
  ]
}
