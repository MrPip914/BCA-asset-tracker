# clasp credentials — a live token that can rewrite the backend. This repo is PUBLIC.
.clasprc.json
.clasp.json

# Local deploy config (holds the Apps Script ID / deployment ID)
deploy.config.json

node_modules/

# The real inventory and the scripts that build it. THIS REPO IS PUBLIC, and this
# directory holds the school's actual data: every staff member by name, which room
# each one sits in, and every device's serial number and hostname. Committing it
# would publish all of that permanently — git history outlives a deletion, and
# public repos are scraped and indexed.
#
# Nothing needs it here. The importer (BCA Admin > Import inventory) reads the CSV
# from a tab in the Sheet itself, precisely so the data never has to be published to
# be imported. See the ADMIN TOOLS section of AssetTrackerSync.gs.
import/
